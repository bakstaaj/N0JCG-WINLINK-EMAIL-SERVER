# N0JCG Winlink Email Server - Retevis RT95 / DigiRig Mobile
# 1200-baud AFSK packet profile. The radio must be tuned to the selected
# frequency separately; Dire Wolf supplies the packet modem.
# The systemd service meters the ALSA stream and forwards PCM on stdin.
ADEVICE stdin plughw:Device,0
CHANNEL 0
MYCALL N0JCG-3
MODEM 1200
# DigiRig Mobile uses the CP210x serial adapter's RTS line for PTT.
PTT /dev/digirig-serial RTS
AGWPORT 8000
KISSPORT 8001
