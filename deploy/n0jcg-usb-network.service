[Unit]
Description=N0JCG Winlink USB network activation
Requires=n0jcg-usb-gadget.service
After=n0jcg-usb-gadget.service NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/n0jcg-usb-network.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
